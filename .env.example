APP_ENV=development
DATABASE_URL=sqlite:///./bankguard.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
SEED_DEMO=true
SIMULATION_INTERVAL=1.5
SESSION_HOURS=8
# Public synthetic demo credentials. Replace before any shared deployment.
DEMO_CUSTOMER_EMAIL=customer@bankguard.test
DEMO_CUSTOMER_PASSWORD=Customer-demo-123!
DEMO_ANALYST_EMAIL=analyst@bankguard.test
DEMO_ANALYST_PASSWORD=Analyst-demo-123!
DEMO_ADMIN_EMAIL=admin@bankguard.test
DEMO_ADMIN_PASSWORD=Admin-demo-123!
# Used only by the local Compose database; override for deployment.
POSTGRES_USER=bankguard
POSTGRES_PASSWORD=local-demo-database-only
POSTGRES_DB=bankguard
